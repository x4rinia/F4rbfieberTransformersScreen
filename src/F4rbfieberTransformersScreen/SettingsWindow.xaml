<Window x:Class="F4rbfieberTransformersScreen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transformers // Einstellungen"
        Width="780" Height="840" MinWidth="680" MinHeight="650"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Background="#03080D" Foreground="#E8F5FB">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#07131D" />
        <SolidColorBrush x:Key="Line" Color="#315B72" />
        <SolidColorBrush x:Key="Accent" Color="#65D9FF" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91B3C5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65D9FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#081720" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4D8AA5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="#081720"
                                                BorderBrush="#4D8AA5"
                                                BorderThickness="1">
                                            <Grid>
                                                <Path Width="10" Height="6" Margin="0,0,13,0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Data="M 0 0 L 5 5 L 10 0 Z" Fill="#FFFFFF" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#65D9FF" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#0C2230" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#65D9FF" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#071016" />
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="12,0,38,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="#FFFFFF" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300"
                                        Margin="0,2,0,0" Padding="2"
                                        Background="#061119" BorderBrush="#65D9FF" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#65D9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#081720" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#12364A" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4D8AA5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D5874" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#65D9FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="17" Height="17"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="#081720" BorderBrush="#6A9CB2" BorderThickness="1">
                                <Path x:Name="CheckMark" Visibility="Collapsed"
                                      Margin="2" Stretch="Uniform"
                                      Data="M 1 6 L 5 10 L 12 1"
                                      Stroke="#FFFFFF" StrokeThickness="2.2"
                                      StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="#FFFFFF" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#0D5874" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#65D9FF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#65D9FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#0B1B27" />
            <Setter Property="Foreground" Value="#F0FAFF" />
            <Setter Property="BorderBrush" Value="#4D849F" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#07131D" />
            <Setter Property="BorderBrush" Value="#315B72" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,24,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#E83843" />
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="TRANSFORMERS" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="CYBERTRON SYSTEM HUD  //  WINDOWS-EINSTELLUNGEN"
                           Margin="0,4,0,0" FontSize="12" Foreground="#65D9FF" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="TRANSFORMER-AUSWAHL" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PROFILMODUS" />
                                <ComboBox x:Name="ProfileModeCombo" SelectionChanged="ProfileModeChanged">
                                    <ComboBoxItem Content="Einen Transformer fest verwenden" Tag="fixed" />
                                    <ComboBoxItem Content="Aktivierte Transformer automatisch wechseln" Tag="cycle" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="START-/STANDARD-TRANSFORMER" />
                                <ComboBox x:Name="TransformerCombo">
                                    <ComboBoxItem Content="Grimlock // Dinobot" Tag="grimlock" />
                                    <ComboBoxItem Content="Hound // Autobot" Tag="hound" />
                                    <ComboBoxItem Content="Optimus Prime // Autobot" Tag="optimus" />
                                    <ComboBoxItem Content="Bumblebee // Autobot" Tag="bumblebee" />
                                    <ComboBoxItem Content="Megatron // Decepticon" Tag="megatron" />
                                    <ComboBoxItem Content="Shockwave // Decepticon" Tag="shockwave" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PROFILWECHSEL BEI DURCHLAUF" />
                                <ComboBox x:Name="ProfileCycleIntervalCombo">
                                    <ComboBoxItem Content="Alle 30 Sekunden" Tag="30" />
                                    <ComboBoxItem Content="Alle 60 Sekunden" Tag="60" />
                                    <ComboBoxItem Content="Alle 2 Minuten" Tag="120" />
                                    <ComboBoxItem Content="Alle 5 Minuten" Tag="300" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TRANSFORMATION AUTOMATISCH ÄNDERN" />
                                <ComboBox x:Name="TransformationIntervalCombo">
                                    <ComboBoxItem Content="Aus" Tag="0" />
                                    <ComboBoxItem Content="Alle 5 Sekunden" Tag="5" />
                                    <ComboBoxItem Content="Alle 10 Sekunden" Tag="10" />
                                    <ComboBoxItem Content="Alle 15 Sekunden" Tag="15" />
                                    <ComboBoxItem Content="Alle 30 Sekunden" Tag="30" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="START-/DAUERFORM" />
                                <ComboBox x:Name="StartFormCombo">
                                    <ComboBoxItem Content="Roboterform" Tag="robot" />
                                    <ComboBoxItem Content="Alt-Mode" Tag="alt" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"
                                       Foreground="#8BA9BA" FontSize="11" TextWrapping="Wrap"
                                       Text="Bei „Aus“ bleibt diese Form dauerhaft sichtbar. Bei aktivem Intervall legt sie die Startform fest." />
                        </Grid>

                        <Border x:Name="ProfileCycleSelectionPanel" Margin="0,20,0,0" Padding="14"
                                Background="#061019" BorderBrush="#274A5D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PROFILE IM AUTOMATISCHEN WECHSEL" />
                                <TextBlock Margin="0,0,0,8" Foreground="#8BA9BA" FontSize="11" TextWrapping="Wrap"
                                           Text="Diese Auswahl betrifft nur den automatischen Profilwechsel. Standard-Transformer und Roboter-/Alt-Mode bleiben unabhängig." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="#D0A247" FontSize="11" FontWeight="Bold" Text="DINOBOTS" />
                                        <CheckBox x:Name="GrimlockCycleCheck" Content="Grimlock" Tag="grimlock" Click="ProfileSelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="#7CB7FF" FontSize="11" FontWeight="Bold" Text="AUTOBOTS" />
                                        <CheckBox x:Name="HoundCycleCheck" Content="Hound" Tag="hound" Click="ProfileSelectionChanged" />
                                        <CheckBox x:Name="OptimusCycleCheck" Content="Optimus Prime" Tag="optimus" Click="ProfileSelectionChanged" />
                                        <CheckBox x:Name="BumblebeeCycleCheck" Content="Bumblebee" Tag="bumblebee" Click="ProfileSelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Foreground="#E785FF" FontSize="11" FontWeight="Bold" Text="DECEPTICONS" />
                                        <CheckBox x:Name="MegatronCycleCheck" Content="Megatron" Tag="megatron" Click="ProfileSelectionChanged" />
                                        <CheckBox x:Name="ShockwaveCycleCheck" Content="Shockwave" Tag="shockwave" Click="ProfileSelectionChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ProfileSelectionHint" Foreground="#8BE4FF" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="MONITORE" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="BILDSCHIRMSCHONER ANZEIGEN AUF" />
                        <ComboBox x:Name="MonitorCombo">
                            <ComboBoxItem Content="Nur Monitor 1 (Standard)" Tag="1" />
                            <ComboBoxItem Content="Nur Monitor 2" Tag="2" />
                            <ComboBoxItem Content="Nur Monitor 3" Tag="3" />
                            <ComboBoxItem Content="Alle Monitore" Tag="all" />
                        </ComboBox>
                        <TextBlock Margin="0,10,0,0" Foreground="#8BA9BA" FontSize="12" TextWrapping="Wrap"
                                   Text="Nicht ausgewählte Monitore bleiben vollständig schwarz. Ist der gewählte Monitor nicht vorhanden, wird automatisch Monitor 1 verwendet." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="SYSTEMDATEN" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PERSONALISIERTER NODE-NAME" />
                        <TextBox x:Name="CustomNameInput" MaxLength="30" Margin="0,0,0,10" Padding="6" Background="#04121c" Foreground="#dff5ff" BorderBrush="#55B9D9" />
                        
                        <CheckBox x:Name="RealDataCheck" Content="Echte Windows-/Hardware-Telemetrie verwenden" />
                        <CheckBox x:Name="EventsCheck" Content="Dezente System- und Transformationshinweise anzeigen" />
                        <TextBlock Margin="24,7,0,0" Foreground="#7F9FB1" FontSize="11" TextWrapping="Wrap"
                                   Text="CPU, GPU, RAM, Temperaturen, Netzwerk, Datenträger, Prozesse, Hostname und Uptime werden aus der bewährten Windows-Sensorbasis gelesen." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ZUFÄLLIGE CYBERTRON-EREIGNISSE" Margin="0,15,0,5" />
                        <ComboBox x:Name="RandomEventsCombo">
                            <ComboBoxItem Content="Aus" Tag="off" />
                            <ComboBoxItem Content="Selten" Tag="rare" />
                            <ComboBoxItem Content="Normal" Tag="normal" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="DARSTELLUNG" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ANIMATIONSQUALITÄT" />
                                <ComboBox x:Name="QualityCombo">
                                    <ComboBoxItem Content="High" />
                                    <ComboBoxItem Content="Medium" />
                                    <ComboBoxItem Content="Low" />
                                </ComboBox>
                                <CheckBox x:Name="EnergySavingCheck" Content="Energiesparmodus" Margin="0,15,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ZIELBILDRATE" />
                                <ComboBox x:Name="FpsCombo">
                                    <ComboBoxItem Content="60" />
                                    <ComboBoxItem Content="45" />
                                    <ComboBoxItem Content="30" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="PathText" VerticalAlignment="Center" Foreground="#648295" FontSize="10"
                       TextTrimming="CharacterEllipsis" MaxWidth="380" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ABBRECHEN" Width="126" Click="CancelClick" />
                <Button Content="SPEICHERN" Width="126" Foreground="#8BE4FF" BorderBrush="#55B9D9" Click="SaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
