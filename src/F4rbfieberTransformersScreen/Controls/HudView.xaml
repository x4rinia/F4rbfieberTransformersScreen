<UserControl x:Class="F4rbfieberTransformersScreen.Controls.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#000000">
    <Grid Background="#000000">
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#000000" />
        <Border x:Name="Fallback" Visibility="Collapsed" Background="#000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="CYBERTRON HUD // WEB RENDERER OFFLINE" FontSize="22" Foreground="#65D9FF" HorizontalAlignment="Center" />
                <TextBlock x:Name="FallbackMessage" Margin="0,12,0,0" Foreground="#7895A4" FontSize="12" TextAlignment="Center" MaxWidth="720" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
